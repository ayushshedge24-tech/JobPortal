# ==========================================
# JobPortal 2.0 Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment (development / production / test)
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/jobportal

# JWT Access Token Secret (Min 32 characters for production)
JWT_SECRET=jobportal_production_jwt_secret_key_change_me_in_production_32char

# JWT Refresh Token Secret (Min 32 characters for production)
REFRESH_TOKEN_SECRET=jobportal_production_refresh_token_secret_change_me_32char

# CORS Allowed Client Origins (Comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000
